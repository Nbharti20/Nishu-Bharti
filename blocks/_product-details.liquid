{% assign product = product | default: all_products['your-product-handle'] %}

<div class="custom-product-card">
  <!-- Product Image -->
  <div class="product-image">
    <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title }}">
  </div>

  <!-- Product Info -->
  <div class="product-info">
    <h2 class="product-title">{{ product.title }}</h2>
    <p class="product-price">{{ product.price | money }}</p>
    <p class="product-description">
      {{ product.description | strip_html | truncatewords: 20 }}
    </p>

    <!-- Product Form -->
    <form method="post" action="/cart/add">
      <input type="hidden" name="id" value="{{ product.variants.first.id }}">

      <!-- Color Selector -->
      {% assign color_index = 0 %}
      {% for option in product.options_with_values %}
        {% if option.name == 'Color' %}
          <div class="product-option">
            <label>Color</label>
            <div class="color-selector">
              {% for value in option.values %}
                <label class="color-pill">
                  <input type="radio"
                         name="options[{{ option.name }}]"
                         value="{{ value }}"
                         {% if forloop.first %}checked{% endif %}>
                  {{ value }}
                </label>
              {% endfor %}
            </div>
          </div>
        {% endif %}
      {% endfor %}

      <!-- Size Selector -->
      {% for option in product.options_with_values %}
        {% if option.name == 'Size' %}
          <div class="product-option">
            <label>Size</label>
            <select name="options[{{ option.name }}]" class="size-selector" required>
              <option disabled selected>Choose your size</option>
              {% for value in option.values %}
                <option value="{{ value }}">{{ value }}</option>
              {% endfor %}
            </select>
          </div>
        {% endif %}
      {% endfor %}

      <!-- Add to Cart Button -->
      <button type="submit" class="add-to-cart-btn">
        ADD TO CART <span class="arrow">→</span>
      </button>
    </form>
  </div>
</div>

<style>
.custom-product-card {
  max-width: 380px;
  margin: auto;
  font-family: sans-serif;
  padding: 20px;
  border: 1px solid #e2e2e2;
}
.product-image img {
  width: 100%;
  height: auto;
  margin-bottom: 16px;
}
.product-title {
  font-size: 20px;
  margin-bottom: 4px;
}
.product-price {
  font-size: 18px;
  font-weight: bold;
  margin-bottom: 8px;
}
.product-description {
  font-size: 14px;
  margin-bottom: 16px;
}
.product-option {
  margin-bottom: 16px;
}
.color-selector {
  display: flex;
  gap: 10px;
  margin-top: 8px;
}
.color-pill {
  border: 1px solid black;
  padding: 10px 16px;
  cursor: pointer;
  font-weight: bold;
}
.color-pill input {
  display: none;
}
.size-selector {
  width: 100%;
  padding: 10px;
  border: 1px solid black;
  font-size: 14px;
}
.add-to-cart-btn {
  margin-top: 20px;
  background-color: black;
  color: white;
  border: none;
  width: 100%;
  padding: 14px;
  font-size: 16px;
  font-weight: 600;
  cursor: pointer;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8px;
  text-transform: uppercase;
}
.arrow {
  font-size: 18px;
  display: inline-block;
  transform: translateY(1px);
}
@media screen and (max-width: 480px) {
  .custom-product-card {
    padding: 16px;
  }
}
</style>

